# Cloudflare Pages — HTTP-заголовки для статических ресурсов
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML should revalidate on every request, otherwise search checks can keep
# seeing stale page markup after a successful Pages deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/de/*
  Cache-Control: public, max-age=0, must-revalidate

/en/*
  Cache-Control: public, max-age=0, must-revalidate

/ru/*
  Cache-Control: public, max-age=0, must-revalidate

/uk/*
  Cache-Control: public, max-age=0, must-revalidate

# Долгосрочное кеширование хешированных ассетов
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000

/favicon.ico
  Cache-Control: public, max-age=86400

/assets/images/favicon-*.png
  Cache-Control: public, max-age=86400

/assets/images/android-chrome-*.png
  Cache-Control: public, max-age=86400

/assets/images/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/assets/images/maskable-icon-512x512.png
  Cache-Control: public, max-age=86400

/assets/images/mstile-150x150.png
  Cache-Control: public, max-age=86400

/assets/images/search-logo-transparent-512.png
  Cache-Control: public, max-age=86400

/assets/images/search-logo-clear-512.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/browserconfig.xml
  Cache-Control: public, max-age=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Виджет погоды (версионированный)
/3d-weather-codrops-main/dist-widget/*
  Cache-Control: public, max-age=86400

# IndexNow key must be easy for search engines to verify
/indexnow-key.txt
  Cache-Control: public, max-age=300

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Защитные заголовки для всех страниц
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.sunrise-sunset.org https://nominatim.openstreetmap.org https://worldtimeapi.org https://timeapi.io https://server.arcgisonline.com; frame-src https://open.spotify.com https://embed.music.apple.com; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests
