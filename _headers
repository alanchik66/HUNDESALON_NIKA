# Cloudflare Pages — HTTP-заголовки для статических ресурсов
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML should revalidate on every request, otherwise search checks can keep
# seeing stale page markup after a successful Pages deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/de/*
  Cache-Control: public, max-age=0, must-revalidate

/en/*
  Cache-Control: public, max-age=0, must-revalidate

/ru/*
  Cache-Control: public, max-age=0, must-revalidate

/uk/*
  Cache-Control: public, max-age=0, must-revalidate

# Долгосрочное кеширование хешированных ассетов
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000

/favicon.ico
  Cache-Control: public, max-age=86400

/assets/images/favicon/*
  Cache-Control: public, max-age=86400

/assets/images/brand/*
  Cache-Control: public, max-age=86400

/assets/images/hero/*
  Cache-Control: public, max-age=31536000

/assets/images/icons/*
  Cache-Control: public, max-age=31536000

/assets/images/before-after/*
  Cache-Control: public, max-age=31536000

/site.webmanifest
  Cache-Control: public, max-age=86400

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Search-engine control files must always revalidate after a deployment
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate

/sitemap-brand.xml
  Cache-Control: public, max-age=0, must-revalidate

/browserconfig.xml
  Cache-Control: public, max-age=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Виджет погоды (версионированный)
/3d-weather-codrops-main/dist-widget/*
  Cache-Control: public, max-age=86400

# IndexNow key must be easy for search engines to verify
/indexnow-key.txt
  Cache-Control: public, max-age=300

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Защитные заголовки для всех страниц
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: on
