+
+    def test_is_elevated_non_admin(self, monkeypatch):
+        """Test is_elevated when User is not an Admin."""
+        import ctypes
+        mock_windll = MagicMock()
+        mock_windll.shell32.IsUserAnAdmin.return_value = 0
+        monkeypatch.setattr(ctypes, "windll", mock_windll, raising=False)
+
+        assert is_elevated() is False
+
