+class TestIsElevated:
+    def test_is_elevated_admin(self, monkeypatch):
+        """Test is_elevated when User is an Admin on Windows."""
+        import ctypes
+        # Mock ctypes.windll.shell32.IsUserAnAdmin to return 1
+        mock_windll = MagicMock()
+        mock_windll.shell32.IsUserAnAdmin.return_value = 1
+        monkeypatch.setattr(ctypes, "windll", mock_windll, raising=False)
