+class TestResolveKnownFolderGuidPath:
+    def test_not_guid_path(self):
+        # Path with no guid-like format should be returned unchanged
+        path = "C:\\Windows\\System32"
+        assert resolve_known_folder_guid_path(path) == path
+
+    def test_guid_path_invalid_guid(self):
+        # A guid-like path with non-hex characters
+        path = "{ZZZZZZZZ-YYYY-XXXX-WWWW-VVVVVVVVVVVV}\\test.exe"
+        assert resolve_known_folder_guid_path(path) == path
+
+    def test_guid_path_exception_handling(self, monkeypatch):
+        """Test GUID path resolution when pywintypes/shell is missing or raises exception."""
+        # If pywintypes or win32com cannot be imported or raise exception, return unchanged path
+        monkeypatch.setitem(sys.modules, "pywintypes", None)
+        path = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\msinfo32.exe"
+        assert resolve_known_folder_guid_path(path) == path
+
+    def test_guid_path_success(self, monkeypatch):
+        """Test successful Known Folder GUID resolution using mocks."""
+        mock_pywintypes = MagicMock()
+        mock_shell_mod = MagicMock()
+
+        # Mock SHGetKnownFolderPath to return a dummy folder path
+        mock_shell_mod.shell.SHGetKnownFolderPath.return_value = "C:\\MockWindows"
+
+        # Mock pywintypes.IID behavior
+        mock_pywintypes.IID.return_value = "dummy_iid"
+
+        # Apply mocks to sys.modules
+        monkeypatch.setitem(sys.modules, "pywintypes", mock_pywintypes)
+        monkeypatch.setitem(sys.modules, "win32com.shell", mock_shell_mod)
+
+        guid_path = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\\msinfo32.exe"
+        expected_path = "C:\\MockWindows/msinfo32.exe" if sys.platform != "win32" else "C:\\MockWindows\\msinfo32.exe"
+
+        resolved = resolve_known_folder_guid_path(guid_path)
+        assert resolved.replace("\\", "/") == expected_path.replace("\\", "/")
+
