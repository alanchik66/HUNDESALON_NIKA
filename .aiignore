# GitLens AI context exclusions (v17.10+)
# Prevent secrets and build artifacts from entering AI prompts.

.env*
.dev.vars*
*.token
*.pem
*.key

# Build and deployment artifacts
dist/
backups/
.wrangler/

# Heavy generated assets
3d-weather-codrops-main/dist-widget/assets/Moon/

# Graphify artifacts (large JSON/HTML freeze Agent Review)
graphify-out/cache/
graphify-out/graph.html
graphify-out/graph.json
graphify-out/.graphify_*.json
graphify-out/.graphify_*.sig
.playwright-mcp/
output/
.anima/
.tmp-tools/
system_prompt.md
