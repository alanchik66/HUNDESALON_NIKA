{
  "name": "hundesalon-nika-website",
  "version": "1.0.0",
  "description": "Многоязычный сайт салона груминга HUNDESALON NIKA с виджетом погоды",
  "main": "index.html",
  "type": "module",
  "scripts": {
    "start": "serve . -l tcp://127.0.0.1:5502 --no-port-switching",
    "dev": "serve . -l tcp://127.0.0.1:5502 --no-port-switching",
    "dev:5502": "serve . -l 5502",
    "preview": "serve . -l tcp://127.0.0.1:5502 --no-port-switching",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint ru/**/*.html de/**/*.html en/**/*.html uk/**/*.html *.html",
    "lint:css": "stylelint assets/css/**/*.css",
    "lint:js": "eslint assets/js/**/*.js",
    "format": "prettier --write assets/js/**/*.js assets/css/**/*.css ru/**/*.html de/**/*.html en/**/*.html uk/**/*.html *.html",
    "backup:full": "node tools/create-full-backup.mjs",
    "validate": "npm run lint && npm run check:links && npm run check:project",
    "check": "npm run validate",
    "check:links": "node tools/check-links.js",
    "check:live-crawl": "node tools/site-crawl-live.mjs",
    "check:live-robots": "node tools/check-live-robots.mjs",
    "check:project": "node tools/check-project.js",
    "shell:strip": "node tools/strip-static-shell.mjs",
    "test:links": "npm run check:links",
    "seo:urls": "node tools/indexnow-submit.js --dry-run",
    "seo:indexnow": "node tools/indexnow-submit.js",
    "seo:submit": "npm run seo:indexnow",
    "seo:post-favicon": "node tools/seo-post-favicon.mjs",
    "bing:api": "node tools/bing-url-submit.mjs",
    "bing:open": "node tools/open-bing-webmaster.mjs",
    "bing:automate": "node tools/bing-webmaster-automate.mjs",
    "bing:edge": "node tools/start-edge-bing-debug.mjs",
    "bing:audit": "node tools/bing-webmaster-audit.mjs",
    "bing:list-sites": "node tools/bing-list-sites.mjs",
    "bing:edge-gmail": "node tools/start-edge-bing-gmail.mjs",
    "bing:consolidate": "node tools/bing-consolidate-accounts.mjs",
    "bing:gmail-status": "node tools/bing-consolidate-accounts.mjs gmail-status",
    "bing:gmail-remove": "node tools/bing-consolidate-accounts.mjs gmail-remove-site",
    "bing:gmail-signout": "node tools/bing-consolidate-accounts.mjs gmail-signout",
    "bing:mail-status": "node tools/bing-consolidate-accounts.mjs mail-status",
    "bing:mail-setup": "node tools/bing-mail-setup-only.mjs",
    "bing:verify": "node tools/bing-verify-site.mjs",
    "bing:setup": "node tools/bing-professional-setup.mjs",
    "bing:index-all": "node tools/bing-index-all-site.mjs",
    "bing:submit-www-rem": "node tools/bing-index-all-site.mjs --www-rem",
    "bing:performance": "node tools/bing-performance-setup.mjs",
    "bing:auto": "node tools/bing-consolidate-accounts.mjs auto",
    "bing:force-clean": "node tools/bing-force-clean.mjs",
    "bing:prefill-mail": "node tools/bing-prefill-mail-login.mjs",
    "google:gsc:audit": "node tools/google-search-console-audit.js",
    "google:gsc:browser": "node tools/gsc-browser-automate.js",
    "build": "npm run validate && npm run build:production",
    "build:production": "node tools/build-production.js",
    "brand:assets": "powershell -ExecutionPolicy Bypass -File tools/generate-brand-assets.ps1",
    "brand:seo": "node tools/update-brand-search-seo.js",
    "brand:sitemap": "node tools/generate-brand-sitemap.mjs",
    "brand:full": "npm run brand:assets && npm run brand:seo && npm run brand:sitemap",
    "bing:brand-sitemap": "node tools/bing-submit-brand-sitemap.mjs",
    "bing:complete": "node tools/bing-webmaster-complete.mjs",
    "bing:finish-manual": "node tools/bing-finish-manual.mjs",
    "bing:finish-remaining": "node tools/bing-finish-remaining.mjs",
    "bing:robots-tester": "node tools/bing-robots-tester.mjs",
    "build:weather": "cd 3d-weather-codrops-main && npm run build:widget",
    "moon:build-alpha": "node tools/build-moon-alpha-webm.mjs",
    "moon:convert-ae": "powershell -ExecutionPolicy Bypass -File scripts/convert_to_webm.ps1",
    "sun:import-reference": "node tools/import-sun-reference.mjs",
    "sun:fetch-nasa": "node tools/fetch-nasa-sun-source.mjs",
    "sun:build-alpha": "node tools/build-sun-alpha-webm.mjs",
    "sun:rebuild": "npm run sun:fetch-nasa && npm run sun:build-alpha",
    "optimize:images": "echo 'Оптимизация изображений: используйте online-сервисы или установите imagemin'",
    "deploy:prepare": "npm run validate",
    "clean": "node -e \"const fs=require('fs'); for (const dir of ['dist','temp','test-results']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "audit": "npm audit",
    "audit:root": "npm audit --audit-level=moderate",
    "audit:gateway": "npm --prefix integrations/google-gateway audit --audit-level=moderate",
    "audit:all": "npm run audit:root && npm run audit:gateway",
    "update": "npm update && cd 3d-weather-codrops-main && npm update",
    "dev:cf": "npm run build:production && node tools/sync-dev-vars.js && wrangler pages dev dist --port=8788",
    "dev:cf:lan": "npm run build:production && node tools/sync-dev-vars.js && wrangler pages dev dist --ip=0.0.0.0 --port=8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=hundesalon-nika",
    "deploy:full": "npm run deploy && node tools/post-deploy.mjs",
    "dev:worker": "wrangler dev --config workers/wrangler.toml --port=8789",
    "dev:worker:lan": "wrangler dev --config workers/wrangler.toml --ip=0.0.0.0 --port=8789",
    "deploy:worker": "wrangler deploy --config workers/wrangler.toml",
    "deploy:worker:dry-run": "wrangler deploy --config workers/wrangler.toml --dry-run",
    "cf:ensure-api-token": "node tools/ensure-cf-api-token.mjs",
    "cf:open-api-token": "node tools/open-cf-api-token.mjs",
    "cf:set-api-token": "node tools/set-cf-api-token.mjs",
    "cf:edge-dashboard": "node tools/start-edge-cf-dashboard.mjs",
    "cf:chrome-dashboard": "node tools/start-chrome-cf-dashboard.mjs",
    "cf:chrome-user-debug": "node tools/start-chrome-user-debug.mjs",
    "cf:open-edit-token": "node tools/open-cf-edit-existing-token.mjs",
    "cf:purge-cache": "node tools/purge-cloudflare-cache.mjs",
    "cf:configure-cache-features": "node tools/configure-cloudflare-cache-features.mjs",
    "cf:www-robots-setup": "node tools/cf-www-robots-setup.mjs",
    "cf:www-robots-redirect": "node tools/configure-www-robots-redirect.mjs",
    "cf:open-www-robots-redirect": "node tools/open-cf-www-robots-redirect.mjs",
    "cf:open-cache-configuration": "node tools/open-cf-cache-configuration.mjs",
    "cf:open-csam-setup": "node tools/open-cf-csam-setup.mjs",
    "cf:configure-waf-rate-limits": "node tools/configure-cloudflare-waf-rate-limits.mjs",
    "cf:open-waf-rate-limits": "node tools/open-cf-waf-rate-limits.mjs",
    "pages:secrets:prune": "node tools/prune-pages-service-gateway-secrets.mjs",
    "resend:set-local": "node tools/set-resend-secret.mjs --local",
    "resend:set-pages": "node tools/set-resend-secret.mjs --pages",
    "resend:set-all": "node tools/set-resend-secret.mjs --all",
    "resend:check-live": "node tools/check-resend-live.mjs",
    "sync:service-key": "node tools/sync-service-gateway-from-devvars.mjs",
    "service-key:validate": "node tools/validate-service-gateway-key.mjs",
    "google:setup-platform": "node tools/setup-google-platform.mjs",
    "check:message-draft": "node tools/check-message-draft-live.mjs",
    "slack:test": "node tools/slack-test-webhook.mjs",
    "check:prod": "npm run check:live-html && npm run google:gsc:audit && npm run check:message-draft",
    "check:all": "node tools/check-all.mjs",
    "git:push": "node tools/git-push-all.mjs",
    "git:cleanup": "node tools/git-cleanup.mjs",
    "sync:gitlab:push": "git fetch gitlab && git push gitlab main:main --force-with-lease",
    "sync:gitlab:mr": "node -e \"console.error('GitLab sync MR disabled: repository must keep only main. Use npm run git:push.'); process.exit(1)\"",
    "check:live-html": "node tools/check-live-html.mjs",
    "print-report": "node -e \"console.log(require('fs').readFileSync('fix-repo-report.txt', 'utf8').substring(0, 5000))\"",
    "rollout:plan": "node -e \"console.log('See docs/operations.md')\""
  },
  "keywords": [
    "grooming",
    "dogs",
    "cats",
    "salon",
    "leipzig",
    "multilingual",
    "website",
    "weather-widget"
  ],
  "author": "HUNDESALON NIKA",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "eslint": "^10.6.0",
    "htmlhint": "^1.9.2",
    "leaflet": "^1.9.4",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "serve": "^14.2.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.20.1"
  },
  "engines": {
    "node": ">=24.16.0 <27",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alanchik66/HUNDESALON_NIKA.git"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260617.1": true,
    "sharp@0.34.5": true
  }
}
