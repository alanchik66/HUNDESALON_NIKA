  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "3.1.5",
    "undici": "7.29.0",
    "ws": "^8.20.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=24.16.0 <27",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
