# Copy to .dev.vars for local Cloudflare Pages dev (npm run dev:cf).
# Never commit .dev.vars. For production, use Cloudflare Pages secrets.

# Inference key only (chat). Do NOT use a management/provisioning key here.
SERVICE_GATEWAY_API_KEY=
# Optional SEO endpoint overrides. Code defaults are production-ready:
# SERVICE_GATEWAY_SEO_MODEL=google/gemini-2.5-flash-lite
# SERVICE_GATEWAY_SEO_FALLBACK_MODEL=deepseek/deepseek-v4-flash
# SERVICE_GATEWAY_SEO_MAX_TOKENS=720
# Bing Webmaster → Settings → API Access (optional; IndexNow works without it)
BING_WEBMASTER_API_KEY=
# Resend.com API key for local Cloudflare Pages Functions.
# Starts with re_. Production value must be a Cloudflare Pages secret, not a committed file.
RESEND_API_KEY=

# Full-stack platform integrations. Keep production values in Cloudflare Pages secrets only.
GA_MEASUREMENT_ID=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_CALENDAR_ID=primary
SHEET_ID=
DRIVE_UPLOAD_FOLDER=
GMAIL_SENDER=info@hundesalon-nika.com
RESEND_FROM=Hundesalon Nika <noreply@hundesalon-nika.com>
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_DRIVE_UPLOAD_WEBHOOK_URL=
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_GATEWAY_SECRET=
MS_GRAPH_ACCESS_TOKEN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OUTLOOK_SENDER=
TEAM_ID=
TEAM_CHANNEL_ID=
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
PAYMENT_PROVIDER_KEY=

# Zone API token with Cache Purge (create via npm run cf:open-purge-token)
# Full zone token (purge + rules): npm run cf:ensure-api-token
CLOUDFLARE_API_TOKEN=
# Or Global API Key (My Profile → API Keys) to auto-create purge token:
# Optional — auto-create Zone Rules token (npm run cf:ensure-zone-rules-token):
# Prefer gitignored .cloudflare-global.json (see .cloudflare-global.json.example)
# Or:
# CLOUDFLARE_API_EMAIL=
# CLOUDFLARE_API_KEY=
