# Copy to .dev.vars for local Cloudflare Pages dev (npm run dev:cf).
# Never commit .dev.vars. For production, use Cloudflare Pages secrets.

# Inference key only (chat). Do NOT use a management/provisioning key here.
SERVICE_GATEWAY_API_KEY=
# Optional SEO endpoint overrides. Code defaults are production-ready:
# SERVICE_GATEWAY_SEO_MODEL=google/gemini-2.5-flash-lite
# SERVICE_GATEWAY_SEO_FALLBACK_MODEL=deepseek/deepseek-v4-flash
# SERVICE_GATEWAY_SEO_MAX_TOKENS=720
# Bing Webmaster → Settings → API Access (optional; IndexNow works without it)
BING_WEBMASTER_API_KEY=
# SendPulse server-side credentials. Use either a static API key or OAuth client credentials.
SENDPULSE_API_KEY=
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_ADDRESSBOOK_ID=
SENDPULSE_FROM=Hundesalon Nika <noreply@hundesalon-nika.com>
# Automation 360 custom-event resource names (not full URLs).
SENDPULSE_BOOKING_EVENT_NAME=
SENDPULSE_CONTACT_EVENT_NAME=
SENDPULSE_NEWSLETTER_EVENT_NAME=

# Full-stack platform integrations. Keep production values in Cloudflare Pages secrets only.
GA_MEASUREMENT_ID=
# Public Google Ads tag IDs (also in config/env.js). Not secrets.
# GOOGLE_ADS_ID=AW-18333140047
# GOOGLE_ADS_CONVERSION_SEND_TO=AW-18333140047/qNqJCKzYu9QcEM-I9qVE
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_CALENDAR_ID=primary
SHEET_ID=
DRIVE_UPLOAD_FOLDER=
GMAIL_SENDER=
# System / admin copies (not public). Client-facing mail uses CLIENT_EMAIL_FROM.
# Public NAP for Search / Ads / site imprint — customers write here; forms land here.
SALON_EMAIL=info@hundesalon-nika.com
CONTACT_RECIPIENT_EMAIL=info@hundesalon-nika.com
BOOKING_RECIPIENT_EMAIL=info@hundesalon-nika.com
# Operational mailbox: customers can write here; we send and reply FROM here.
SUPPORT_EMAIL=support@hundesalon-nika.com
SUPPORT_REPLY_TO_EMAIL=support@hundesalon-nika.com
CLIENT_EMAIL_FROM=Hundesalon Nika <support@hundesalon-nika.com>
ADMIN_NOTIFICATION_EMAILS=snaiper1984@gmail.com,ryndenko1982@gmail.com
GOOGLE_SHARE_EMAIL=snaiper1984@gmail.com,ryndenko1982@gmail.com
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_DRIVE_UPLOAD_WEBHOOK_URL=
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_GATEWAY_SECRET=
MS_GRAPH_ACCESS_TOKEN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OUTLOOK_SENDER=
TEAM_ID=
TEAM_CHANNEL_ID=
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
SITE_NOTIFICATIONS_ENABLED=false
# Telegram manager notifications (bot token and channel/chat ID stay secret).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AGENT_ENABLED=true
TELEGRAM_BOOKING_URL=https://hundesalon-nika.com/de/onlayn-bronirovanie
TELEGRAM_TOPIC_MESSAGES_ID=
TELEGRAM_TOPIC_ORDERS_ID=
TELEGRAM_TOPIC_NEWSLETTER_ID=
TELEGRAM_TOPIC_SOCIAL_ID=
TELEGRAM_TOPIC_SYSTEM_ID=
PAYMENT_PROVIDER_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_AMOUNT_CENTS=2000
SITE_ORIGIN=https://hundesalon-nika.com

# Scoped automation token (zone + Pages deploy in one token)
# Create via npm run cf:open-unified-token
CLOUDFLARE_API_TOKEN=

# Legacy alias — same value as CLOUDFLARE_API_TOKEN when unified
# CLOUDFLARE_PAGES_API_TOKEN=

# Online deposits: set true only after salon opens
PAYMENTS_ONLINE_ENABLED=false
