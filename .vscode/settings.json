{
  // ─── Редактор ──────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.inlineSuggest.enabled": true,

  // ─── Файлы ─────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.wrangler": true,
    "**/dist": false,
    "**/.claude": true,
    "**/.codex": true,
    "**/.codex-logs": true,
    "**/.devin": true,
    "**/.pi": true,
    "**/.roo": true,
    "**/.playwright-mcp": true,
    "**/.secrets": true,
    "**/.venv": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.wrangler/**": true,
    "**/.pi/**": true,
    "**/.playwright-mcp/**": true,
    "**/.codex-logs/**": true,
    "**/.venv/**": true
  },

  // ─── Языковые настройки ────────────────────────────────────────────
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ─── Prettier ──────────────────────────────────────────────────────
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,

  // ─── ESLint ────────────────────────────────────────────────────────
  "eslint.validate": ["javascript"],
  "eslint.useFlatConfig": true,

  // ─── Stylelint ─────────────────────────────────────────────────────
  "stylelint.validate": ["css"],
  "css.validate": false,

  // ─── HTMLHint ──────────────────────────────────────────────────────
  "htmlhint.enable": true,

  // ─── Emmet ─────────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "javascript": "html"
  },
  "emmet.triggerExpansionOnTab": true,

  // ─── Git ───────────────────────────────────────────────────────────
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.pruneOnFetch": true,

  // ─── Поиск ─────────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.wrangler": true,
    "**/3d-weather-codrops-main/dist-widget": true,
    "**/assets/vendor": true
  },

  // ─── Терминал ──────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // ─── AI Agents: GCP + Cloudflare env (auto) ───
  "terminal.integrated.env.windows": {
    "GOOGLE_CLOUD_PROJECT": "hundesalon-nika-shell-2026",
    "GCP_PROJECT": "hundesalon-nika-shell-2026",
    "CLOUDSDK_CORE_PROJECT": "hundesalon-nika-shell-2026",
    "CLOUDSDK_COMPUTE_REGION": "europe-west3",
    "GOOGLE_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "ai-agents-admin@hundesalon-nika-shell-2026.iam.gserviceaccount.com",
    "CLOUDFLARE_ACCOUNT_ID": "25e872aeab8cb246c69142ab07cd0fee",
    "NPM_CONFIG_MIN_RELEASE_AGE": null
  },

  // Gemini Code Assist — must match GCP project (not mega-copilot-*)
  "geminicodeassist.project": "hundesalon-nika-shell-2026",

  // ─── Spell Checker (cSpell) ────────────────────────────────────────
  "cSpell.enabled": true,
  "cSpell.language": "en,de,ru,uk",

  // ─── AI: Kilo Code (VS Code / Devin — agent via local Ollama) ─────
  // Autocomplete: Kilo gateway only (mistral/inception/kilo) — use Continue for local tab.
  "kilo-code.new.model.providerID": "ollama",
  "kilo-code.new.model.modelID": "qwen2.5-coder:7b",
  "kilo-code.new.autocomplete.enableAutoTrigger": false,
  "kilo-code.new.autoApprove.enabled": true,
  "kilo-code.new.browserAutomation.enabled": true,
  "kilo-code.new.browserAutomation.useSystemChrome": true,
  "kilo-code.new.browserAutomation.headless": false,
  "kilo-code.new.agentWorkStyle": "autonomous",
  "kilo-code.new.showTaskTimeline": false,
  "kilo-code.new.diff.renderMarkdown": true,
  "kilo-code.new.language": "Русский",
  "kilo-code.new.maxCost": 0,

  // ─── AI: Continue.dev (Ollama) ─────────────────────────────────────
  "continue.enableTabAutocomplete": true,
  "continue.telemetryEnabled": false,

  // ─── AI: Ollama Codex ──────────────────────────────────────────────
  "ollama-codex.model": "qwen2.5-coder:7b",
  "ollama-codex.endpoint": "http://127.0.0.1:11434"
}
