{
  "github.copilot.chat.askAgent.additionalTools": [
    "copilot_sessionStoreSql"
  ],
  "github.copilot.chat.cli.customAgents.enabled": true,
  "github.copilot.chat.localIndex.enabled": true,
  "files.eol": "\n",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.requireConfig": true,
  "eslint.format.enable": false,
  "stylelint.format.enable": false,
  "eslint.validate": [
    "javascript"
  ],
  "stylelint.validate": [
    "css"
  ],
  "htmlhint.enable": true,
  "chat.agent.enabled": true,
  "chat.agent.maxRequests": 25,
  "github.copilot.chat.agent.autoFix": false,
  "chat.mcp.access": "all",
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },
  "chat.mcp.apps.enabled": true,
  "chat.stickyScroll.enabled": true,
  "chat.experimental.stickyScroll.enabled": true,
  "chat.agentSessions.showExternal": true,
  "workbench.browser.autoReloadOnFileChange": true,
  "workbench.editor.showTabs": "multiple",
  "terminal.integrated.resizeDimensionsOverlay.enabled": false,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "args": [
        "-NoProfile"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "git.autofetch": true,
  "git.confirmSync": false,
  "files.autoSave": "afterDelay",
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.editorAssociations": {
    "*.html": "browser.editor.browserPreview"
  },
  "sessions.layout.singlePaneDetailPanel": true,
  "sessions.chatTimeline.display": "ruler",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/test-results/**": true
  },
  "chat.sessionSync.enabled": true
}
