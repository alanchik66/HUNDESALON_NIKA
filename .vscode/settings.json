{
  // ── Редактор ──────────────────────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "on",
  "editor.rulers": [120],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.linkedEditing": true,

  // ── Файлы ─────────────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "*.html": "html",
    "*.css": "css",
    "*.js": "javascript"
  },
  "files.exclude": {
    "node_modules": true,
    ".wrangler": true,
    "dist": true,
    "**/.DS_Store": true
  },

  // ── Форматирование по типу файла ──────────────────────────────────────────
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ── ESLint ────────────────────────────────────────────────────────────────
  "eslint.enable": true,
  "eslint.validate": ["javascript", "html"],
  "eslint.useFlatConfig": true,

  // ── Stylelint ─────────────────────────────────────────────────────────────
  "stylelint.enable": true,
  "stylelint.run": "onSave",
  "stylelint.configFile": "${workspaceFolder}/.stylelintrc.json",
  "stylelint.packageManager": "npm",
  "stylelint.validate": ["css"],
  "stylelint.lintFiles.glob": "assets/css/**/*.css",
  "stylelint.logLevel": "warn",
  "css.validate": false,
  "scss.validate": false,

  // ── HTMLHint ──────────────────────────────────────────────────────────────
  "htmlhint.enable": true,

  // ── Spell checker ────────────────────────────────────────────────────────
  "cSpell.language": "en,de,ru",
  "cSpell.enableFiletypes": ["html", "css", "javascript", "markdown"],

  // ── Обновления VS Code и расширений ─────────────────────────────────────
  "update.mode": "default",
  "extensions.autoUpdate": true,
  "extensions.autoCheckUpdates": true,

  // ── npm-скрипты как основной способ локального превью ───────────────────
  "npm.scriptRunnerShowNotification": "onError",

  // ── Поиск ────────────────────────────────────────────────────────────────
  "search.exclude": {
    "node_modules": true,
    ".wrangler": true,
    "dist": true
  },

  // ── Git ───────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // GitLab CI/pipelines: origin = GitHub, remote "gitlab" — см. .git/config
  "gitlab.pipelineGitRemoteName": "gitlab",

  // ── PowerShell ───────────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // ── Python (не перехватывать терминал в этом JS/HTML проекте) ──────────
  "python.terminal.activateEnvironment": false,
  "python.terminal.activateEnvInCurrentTerminal": false,

  // ── Path Intellisense ────────────────────────────────────────────────────
  "path-intellisense.mappings": {
    "/assets": "${workspaceFolder}/assets"
  },
  "editor.cursorSmoothCaretAnimation": "on",

  // ── Copilot / Chat ───────────────────────────────────────────────────────
  "chat.commandCenter.enabled": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.riskAssessment.enabled": true,
  "chat.planWidget.inlineEditor.enabled": true,

  // ── Agents window (VS Code 1.120) ───────────────────────────────────────
  "extensions.supportAgentsWindow": {
    "github.copilot": true,
    "github.copilot-chat": true,
    "eamodio.gitlens": true,
    "ms-playwright.playwright": true,
    "cloudflare.cloudflare-workers": true
  },

  // ── Markdown diff preview (VS Code 1.120) ───────────────────────────────
  "workbench.diffEditorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "markdown.preview.doubleClickToSwitchToEditor": false,
  "markdown.preview.markEditorSelection": false,
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  }
}
