{
  // ─── Редактор ──────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit"
  },
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "strings": true
  },
  "editor.inlineSuggest.enabled": true,

  // ─── Файлы ─────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.wrangler": true,
    "**/dist": false
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.wrangler/**": true
  },

  // ─── Языковые настройки ────────────────────────────────────────────
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ─── Prettier ──────────────────────────────────────────────────────
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,

  // ─── ESLint ────────────────────────────────────────────────────────
  "eslint.validate": ["javascript"],
  "eslint.useFlatConfig": true,

  // ─── Stylelint ─────────────────────────────────────────────────────
  "stylelint.validate": ["css"],
  "css.validate": false,

  // ─── HTMLHint ──────────────────────────────────────────────────────
  "htmlhint.enable": true,

  // ─── Emmet ─────────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "javascript": "html"
  },
  "emmet.triggerExpansionOnTab": true,

  // ─── Git ───────────────────────────────────────────────────────────
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.pruneOnFetch": true,

  // ─── Поиск ─────────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.wrangler": true,
    "**/3d-weather-codrops-main/dist-widget": true,
    "**/assets/vendor": true
  },

  // ─── Терминал ──────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  // ─── AI Agents: GCP + Cloudflare env (auto) ───
  "terminal.integrated.env.windows": {
    "GOOGLE_CLOUD_PROJECT": "hundesalon-nika-shell-2026",
    "GCP_PROJECT": "hundesalon-nika-shell-2026",
    "CLOUDSDK_CORE_PROJECT": "hundesalon-nika-shell-2026",
    "CLOUDSDK_COMPUTE_REGION": "europe-west3",
    "GOOGLE_AUTH_IMPERSONATE_SERVICE_ACCOUNT": "ai-agents-admin@hundesalon-nika-shell-2026.iam.gserviceaccount.com",
    "CLOUDFLARE_ACCOUNT_ID": "25e872aeab8cb246c69142ab07cd0fee"
  },,

  // ─── Spell Checker (cSpell) ────────────────────────────────────────
  "cSpell.enabled": true,
  "cSpell.language": "en,de,ru,uk",

  // ─── AI: Kilo Code ────────────────────────────────────────────────
  "kilo.enable": true,
  "kilo.configPath": "C:\\Users\\snaip\\.config\\kilo\\kilo.jsonc",
  "kilo.workspaceMode": "user",
  "kilo.ignoreBun": true,
  "kilo.autoCollapseReasoning": false,
  "kilo.terminalCommandDisplay": "expanded",
  "kilo.renderMarkdownDiffs": true,
  "kilo.enableInlineCompletion": true,
  "kilo.enableCodeActions": true,
  "kilo.enableContextualPrompts": true,
  "kilo-code.chat.utilityModel": "anthropic/claude-3-5-sonnet-20241022",
  "kilo-code.chat.utilitySmallModel": "anthropic/claude-3-5-haiku-20241022",
  "kilo-code.chat.autoExpandHistory": true,
  "kilo-code.chat.codeEditDisplay": "expanded",
  "kilo-code.chat.hidePromptTrainingModels": false,
  "kilo-code.inlineCompletion.enable": true,
  "kilo-code.inlineCompletion.model": "anthropic/claude-3-5-haiku-20241022",
  "kilo-code.inlineCompletion.debounce": 150,
  "kilo-code.inlineCompletion.maxSuggestions": 5,

  // ─── AI: Continue.dev (Ollama) ─────────────────────────────────────
  "continue.enableTabAutocomplete": true,
  "continue.telemetryEnabled": false,

  // ─── AI: Ollama Codex ──────────────────────────────────────────────
  "ollama-codex.model": "qwen2.5-coder:latest",
  "ollama-codex.endpoint": "http://localhost:11434"
}
